# Public Supabase project settings (never put a service-role key here).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Google OAuth 2.0 Web Client ID. When set, the customer sign-in page renders Google's official
# "Sign in with Google" button (Google Identity Services) and exchanges the ID token for a
# Supabase session. Add the site origin to the client's Authorized JavaScript origins in Google
# Cloud Console.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Optional contact address included in OpenStreetMap geocoding requests.
ROUTING_CONTACT_EMAIL=
